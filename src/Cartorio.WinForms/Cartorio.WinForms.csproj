<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Cartorio.WinForms</RootNamespace>
    <AssemblyName>ProtocoloCartorio</AssemblyName>
    <!-- campos dos .Designer.cs são inicializados em InitializeComponent, fora do construtor -->
    <NoWarn>$(NoWarn);CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cartorio.Core\Cartorio.Core.csproj" />
    <ProjectReference Include="..\Cartorio.Data\Cartorio.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
